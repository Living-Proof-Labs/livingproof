{
  "name": "Living Proof Labs",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "target": "development",
    "args": {
      "APT_MIRROR": "${localEnv:APT_MIRROR}"
    }
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "containerEnv": {
    "HTTP_PROXY": "${localEnv:HTTP_PROXY}",
    "HTTPS_PROXY": "${localEnv:HTTPS_PROXY}",
    "NO_PROXY": "${localEnv:NO_PROXY}",
    "http_proxy": "${localEnv:http_proxy}",
    "https_proxy": "${localEnv:https_proxy}",
    "no_proxy": "${localEnv:no_proxy}"
  },
  "mounts": [
    "source=${localEnv:DEV_CA_BUNDLE:/dev/null},target=/run/livingproof/extra-ca.crt,type=bind,readonly"
  ],
  "postCreateCommand": ". /usr/local/bin/dev-ca-env.sh && task setup && livingproof --help",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/livingproof-dev/venv/bin/python"
      }
    }
  }
}
